---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import ExperienceChapter from '@/components/chapters/ExperienceChapter.astro';
import ProjectsChapter from '@/components/projects/ProjectsChapter.astro';
import SkillsChapter from '@/components/chapters/SkillsChapter.astro';
import JourneyChapter from '@/components/chapters/JourneyChapter.astro';
import ContactChapter from '@/components/chapters/ContactChapter.astro';
import Footer from '@/components/Footer.astro';
import Globe from '@/components/Globe.astro';
import { person, socials, email } from '@/data/site';
import { skillGroups } from '@/data/skills';
import { withBase } from '@/lib';

const siteUrl = new URL(withBase('/'), Astro.site).href;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'Full Stack Developer',
  description: person.pitch,
  url: siteUrl,
  image: new URL(withBase('og.png'), Astro.site).href,
  email: `mailto:${email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Lahore', addressCountry: 'PK' },
  affiliation: { '@type': 'CollegeOrUniversity', name: person.university },
  sameAs: socials.map((s) => s.href),
  knowsAbout: skillGroups.flatMap((g) => g.skills.map((s) => s.name)),
};
---

<Layout
  title={`${person.name} · Full Stack Developer`}
  description="Mubashir Fayyaz: full stack developer (Next.js, Supabase, TypeScript) working across cloud, AI automation and security. Projects, experience and contact."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />
  <Globe />
  <Nav />
  <main id="main">
    <Hero />
    <ExperienceChapter />
    <ProjectsChapter />
    <SkillsChapter />
    <JourneyChapter />
    <ContactChapter />
  </main>
  <Footer />
</Layout>

<script>
  // Play-mode entrance motion (anime.js, loaded on demand).
  import { initMotion } from '@/scripts/motion';
  initMotion();
</script>
