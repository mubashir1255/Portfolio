---
/**
 * A framed image, or — when no image exists yet — a clearly marked placeholder.
 * Never fill a slot with a fake mockup.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /** shown when there is no image, e.g. "TODO: AgroBid screenshot" */
  placeholder?: string;
  /** CSS aspect-ratio, e.g. "16 / 10" */
  ratio?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { image, alt, placeholder = 'TODO: add image', ratio = '16 / 10', sizes = '(min-width: 768px) 640px, 100vw', loading = 'lazy', class: cls } = Astro.props;
---

{
  image ? (
    <div class:list={['frame halftone--hover', cls]} style={`aspect-ratio: ${ratio}`}>
      <Image src={image} alt={alt} widths={[400, 800, 1200]} sizes={sizes} loading={loading} format="webp" />
    </div>
  ) : (
    <div class:list={['frame slot halftone', cls]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Image coming soon: ${alt}`}>
      <span class="slot__label">{placeholder}</span>
    </div>
  )
}
