---
/** The hero name. Glitches on load, then every 1.5s in Play mode; still under reduced motion. Use once per site. */
interface Props {
  text: string;
  class?: string;
}

const { text, class: cls } = Astro.props;
---

<span class:list={['glitch', cls]}>
  <span>{text}</span>
  <span class="glitch__layer glitch__layer--a" aria-hidden="true">{text}</span>
  <span class="glitch__layer glitch__layer--b" aria-hidden="true">{text}</span>
</span>
