---
import { Menu, X } from '@lucide/astro';
import { navLinks, resumePath } from '@/data/site';
import { withBase } from '@/lib';

const linkClass =
  'rounded-md px-1 text-gray-300 transition hover:text-blue-400 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none';
const resume = withBase(resumePath);
---

<header class="fixed top-0 left-0 z-50 w-full px-4 sm:px-6 lg:px-8" data-hero>
  <div
    class="mx-auto mt-4 flex max-w-7xl items-center justify-between rounded-2xl border border-white/10 bg-white/5 px-6 py-4 backdrop-blur-xl sm:px-8"
  >
    <a
      href="#"
      class="rounded-lg text-xl font-extrabold tracking-wide text-white transition hover:text-blue-400 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none sm:text-2xl"
      aria-label="Mubashir - Home"
      data-logo
    >
      MUBASHIR
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main Navigation">
      {navLinks.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={resume}
        download
        class="hidden rounded-xl bg-blue-600 px-5 py-2 font-semibold text-white transition duration-300 hover:bg-blue-500 hover:shadow-lg hover:shadow-blue-500/40 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none md:block"
      >
        Resume
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="rounded-lg p-1 text-white focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu size={28} class="icon-open" />
        <X size={28} class="icon-close hidden" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed top-24 right-4 left-4 z-[100] hidden rounded-2xl border border-white/10 bg-zinc-900/95 p-6 shadow-2xl backdrop-blur-xl md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation Menu"
  >
    <div class="mb-4 flex items-center justify-between border-b border-white/10 pb-4">
      <span class="text-lg font-extrabold tracking-wide text-white">MUBASHIR</span>
      <span class="rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 text-xs font-medium text-blue-400">
        Full Stack Dev
      </span>
    </div>
    <div class="flex flex-col gap-5" data-menu-items>
      {navLinks.map((l) => <a href={l.href} class={linkClass} data-close-menu>{l.label}</a>)}
      <a
        href={resume}
        download
        data-close-menu
        class="rounded-xl bg-blue-600 px-5 py-3 text-center font-semibold text-white transition hover:bg-blue-500 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none"
      >
        Download Resume
      </a>
    </div>
  </div>
</header>
