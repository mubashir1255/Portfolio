---
import { Menu, X } from '@lucide/astro';
import { navLinks, resumePath } from '@/data/site';
import { withBase } from '@/lib';

const linkClass =
  'rounded-md px-1 text-stone-300 transition hover:text-ember-400 focus-visible:ring-2 focus-visible:ring-ember-500 focus-visible:outline-none';
const resume = withBase(resumePath);
---

<header class="fixed top-0 left-0 z-50 w-full px-4 sm:px-6 lg:px-8">
  <div
    class="mx-auto flex h-[64px] max-w-7xl items-center justify-between border-b border-cream/10 px-1"
  >
    <a
      href="#cover"
      class="rounded font-serif text-xl font-extrabold tracking-wide text-cream transition hover:text-ember-400 focus-visible:ring-2 focus-visible:ring-ember-500 focus-visible:outline-none sm:text-2xl"
      aria-label="Mubashir - Home"
      data-logo
    >
      Mubashir
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main Navigation">
      {navLinks.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={resume}
        download
        class="hidden rounded-md border border-cream/25 px-4 py-1.5 text-sm font-semibold text-cream transition hover:border-ember-500 hover:text-ember-400 focus-visible:ring-2 focus-visible:ring-ember-500 focus-visible:outline-none md:block"
      >
        Resume
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="rounded-lg p-1 text-cream focus-visible:ring-2 focus-visible:ring-ember-500 focus-visible:outline-none md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu size={28} class="icon-open" />
        <X size={28} class="icon-close hidden" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed top-[72px] right-4 left-4 z-[100] hidden rounded-lg border border-cream/10 bg-[#1a1411] p-6 shadow-2xl md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation Menu"
  >
    <div class="mb-4 flex items-center justify-between border-b border-white/10 pb-4">
      <span class="font-serif text-lg font-extrabold text-cream">Mubashir</span>
      <span class="text-xs text-cream/50">Full stack developer</span>
    </div>
    <div class="flex flex-col gap-5" data-menu-items>
      {navLinks.map((l) => <a href={l.href} class={linkClass} data-close-menu>{l.label}</a>)}
      <a
        href={resume}
        download
        data-close-menu
        class="rounded-md bg-ember-600 px-5 py-3 text-center font-semibold text-cream transition hover:bg-ember-500 focus-visible:ring-2 focus-visible:ring-ember-500 focus-visible:outline-none"
      >
        Download Resume
      </a>
    </div>
  </div>
</header>
