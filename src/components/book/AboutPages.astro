---
import Page from './Page.astro';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
import { highlights, stats } from '@/data/content';
---

<Page anchor="about" chapter="About" num={2}>
  <Kicker label="Chapter II" right="About" />
  <h2 class="pg-h2" data-a>Who I <em>Am</em></h2>
  <div class="pg-rule" data-a></div>
  <p class="mt-6 text-[15px] leading-7 text-sepia-700" data-a>
    I'm a full stack developer and BS Information Technology student (since 2023). I work across the stack: interfaces, APIs and databases, cloud deployment and AI automation, and I care a lot about getting security right.
  </p>
  <div class="mt-10 grid grid-cols-3 border-y border-sepia-300 py-5" data-a>
    {
      stats.map((s) => (
        <div class="text-center">
          <div class="font-serif text-4xl font-extrabold text-ember-600 tabular-nums">
            <span data-count={s.value}>{s.value}</span>{s.suffix}
          </div>
          <div class="mt-1 text-[12px] tracking-wide text-sepia-500">{s.label}</div>
        </div>
      ))
    }
  </div>
</Page>

<Page chapter="About" num={3}>
  <Kicker label="What I do" right="II" />
  <h2 class="pg-h2" data-a>What I <em>work on</em></h2>
  <div class="pg-rule" data-a></div>
  <div class="mt-7 space-y-4">
    {
      highlights.map((h, i) => (
        <div class="flex items-start gap-4 border-b border-sepia-300/70 pb-4" data-a>
          <Icon name={h.icon} class="mt-1 h-5 w-5 shrink-0 text-ember-600" />
          <div>
            <div class="flex items-baseline gap-2">
              <span class="font-serif text-sm text-ember-600 italic">0{i + 1}</span>
              <h3 class="text-[17px] font-bold text-sepia-900">{h.title}</h3>
            </div>
            <p class="mt-1 text-[13px] text-sepia-700">{h.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</Page>
