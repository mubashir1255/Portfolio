---
import { ArrowUpRight } from '@lucide/astro';
import Page from './Page.astro';
import Kicker from './Kicker.astro';
import { moreProjects } from '@/data/content';
interface Props { num: number }
---

<Page chapter="Projects" num={Astro.props.num}>
  <Kicker label="Projects" right="Index" />
  <h2 class="pg-h2" data-a>More <em>projects</em></h2>
  <div class="pg-rule" data-a></div>
  <ul class="mt-5 divide-y divide-sepia-300/80 border-y border-sepia-300/80">
    {
      moreProjects.map((m) => (
        <li data-a>
          <a href={m.href} target="_blank" rel="noreferrer" class="group block py-3">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-serif text-[19px] font-bold text-sepia-900 group-hover:text-ember-700">{m.title}</h3>
              <ArrowUpRight class="h-4 w-4 shrink-0 text-sepia-500 group-hover:text-ember-600" />
            </div>
            <p class="mt-0.5 text-[12.5px] leading-5 text-sepia-700">{m.text}</p>
            <p class="mt-1 text-[11px] tracking-wide text-sepia-500">{m.tech}</p>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-[12.5px] text-sepia-500" data-a>
    Everything else is on <a href="https://github.com/mubashir1255" target="_blank" rel="noreferrer" class="ink-link text-sepia-900">GitHub</a>.
  </p>
</Page>
