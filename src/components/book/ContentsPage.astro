---
import Page from './Page.astro';
import { chapters } from '@/data/content';
---

<Page chapter="Contents" variant="endpaper">
  <div class="flex h-full flex-col">
    <p class="text-[11px] font-semibold tracking-[0.3em] text-flare-300/80 uppercase" data-a>Ex libris · Mubashir Fayyaz</p>
    <h2 class="mt-8 font-serif text-5xl font-extrabold text-cream" data-a>Contents</h2>
    <div class="mt-3 h-0.5 w-14 bg-ember-500" data-a></div>
    <ol class="mt-10 space-y-5">
      {
        chapters.map((c) => (
          <li data-a>
            <a href={`#${c.anchor}`} class="toc-row group">
              <span class="w-8 font-serif text-sm text-flare-400 italic">{c.num}</span>
              <span class="font-serif text-2xl text-cream transition group-hover:text-flare-300">{c.title}</span>
              <span class="toc-leader" />
              <span class="font-serif text-lg text-cream/60 tabular-nums">{c.page}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="mt-auto font-serif text-sm text-cream/50 italic" data-a>Turn the page, or jump to a chapter.</p>
  </div>
</Page>
