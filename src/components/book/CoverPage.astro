---
import Page from './Page.astro';
---

<Page anchor="cover" chapter="Cover" variant="cover">
  <div class="cover-frame">
    <p class="cover-small">Portfolio · Vol. 2026</p>
    <svg class="cover-emblem" viewBox="0 0 64 64" aria-hidden="true">
      <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="1.2" />
      <path d="M32 12c4 8 12 11 12 22a12 12 0 0 1-24 0c0-6 3-9 6-12 0 5 2 8 5 8-2-7 1-13 1-18z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
    <h1 class="cover-title" id="cover-title">Mubashir</h1>
    <p class="cover-sub">Full Stack · Cloud &amp; AI · Cybersecurity</p>
    <p class="cover-hint">Click, drag the corner, or press → to open</p>
  </div>
</Page>
