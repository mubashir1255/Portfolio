---
import Page from './Page.astro';
import Kicker from './Kicker.astro';
import { timeline } from '@/data/content';
---

<Page anchor="experience" chapter="Journey" num={13}>
  <Kicker label="Chapter V" right="Journey" />
  <h2 class="pg-h2" data-a>My <em>Journey</em></h2>
  <div class="pg-rule" data-a></div>
  <ol class="relative mt-6 space-y-4 border-l border-sepia-300 pl-6">
    {
      timeline.map((t) => (
        <li class="relative" data-a>
          <span class="absolute top-1.5 -left-[29px] h-2.5 w-2.5 rounded-full bg-ember-500 ring-4 ring-paper" />
          <div class="flex items-baseline gap-3">
            <span class="font-serif text-[17px] font-extrabold whitespace-nowrap text-ember-600">{t.year}</span>
            <h3 class="text-[14.5px] font-bold text-sepia-900">{t.title}</h3>
          </div>
          <p class="mt-0.5 text-[12.5px] leading-5 text-sepia-700">{t.description}</p>
        </li>
      ))
    }
  </ol>
</Page>
