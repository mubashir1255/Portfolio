---
import Page from './Page.astro';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
import { skillCategories } from '@/data/content';
const halves = [skillCategories.slice(0, 3), skillCategories.slice(3)];
---

{
  halves.map((cats, h) => (
    <Page anchor={h === 0 ? 'skills' : undefined} chapter="Skills" num={4 + h}>
      <Kicker label={h === 0 ? 'Chapter III' : 'Skills, continued'} right={h === 0 ? 'Skills' : 'III'} />
      {h === 0 ? (
        <h2 class="pg-h2" data-a>
          Technical <em>Stack</em>
        </h2>
      ) : (
        <h2 class="pg-h2" data-a>
          Ops, AI &amp; <em>Security</em>
        </h2>
      )}
      <div class="pg-rule" data-a />
      <div class="mt-6 space-y-5">
        {cats.map((c) => (
          <section data-a>
            <div class="flex items-center gap-3">
              <Icon name={c.icon} class="h-4 w-4 text-ember-600" />
              <h3 class="text-[16px] font-bold text-sepia-900">{c.title}</h3>
            </div>
            <p class="mt-1.5 text-[12.5px] leading-5 text-sepia-700">{c.tagline}</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {c.skills.map((s) => (
                <span class="chip">{s}</span>
              ))}
            </div>
          </section>
        ))}
      </div>
    </Page>
  ))
}
