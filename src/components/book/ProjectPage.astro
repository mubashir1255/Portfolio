---
import { Lock } from '@lucide/astro';
import Page from './Page.astro';
import Kicker from './Kicker.astro';
import type { Project } from '@/data/content';
interface Props {
  p: Project;
  index: number;
  num: number;
}
const { p, index, num } = Astro.props;
const first = index === 0;
---

<Page anchor={first ? 'projects' : undefined} chapter="Projects" num={num}>
  <Kicker label={first ? 'Chapter IV · Projects' : 'Projects'} right={`No. ${String(index + 1).padStart(2, '0')}`} />

  {
    'image' in p.visual ? (
      <figure class:list={'photo mt-7'} style={`--tilt:${index % 2 ? 1.2 : -1}deg`} data-a>
        <span class="photo-tape" aria-hidden="true" />
        <img src={p.visual.image} alt={`${p.title} screenshot`} loading="lazy" decoding="async" />
      </figure>
    ) : p.visual.kind === 'receipt' ? (
      <figure class:list={'receipt mt-7'} aria-hidden="true" data-a>
        <div class="text-center font-bold tracking-widest">QEVORA POS</div>
        <div class="text-center">Pharmacy · Till 2</div>
        <div class="receipt-rule" />
        <div class="flex justify-between"><span>Paracetamol 500mg ×2</span><span>60.00</span></div>
        <div class="pl-3 text-[9.5px] opacity-75">batch A14 · exp 03/28</div>
        <div class="flex justify-between"><span>ORS sachet ×3</span><span>75.00</span></div>
        <div class="flex justify-between"><span>Vitamin C (loose) ×10</span><span>40.00</span></div>
        <div class="receipt-rule" />
        <div class="flex justify-between font-bold"><span>TOTAL</span><span>Rs 175.00</span></div>
        <div class="flex justify-between"><span>Cash</span><span>200.00</span></div>
        <div class="flex justify-between"><span>Change</span><span>25.00</span></div>
        <div class="receipt-rule" />
        <div class="text-center">Thank you · get well soon</div>
      </figure>
    ) : (
      <figure class:list={'diagram mt-7'} aria-hidden="true" data-a>
        <div class="diagram-row">
          <span class="diagram-box">Browser</span>
          <span class="diagram-arrow">— SSE —</span>
          <span class="diagram-box">FastAPI</span>
        </div>
        <div class="diagram-down">│ query</div>
        <div class="diagram-row">
          <span class="diagram-box">ChromaDB<small>MiniLM embeddings</small></span>
          <span class="diagram-arrow">context →</span>
          <span class="diagram-box is-hot">SmolLM-135M<small>PyTorch · local</small></span>
        </div>
        <div class="diagram-note">no API calls · no telemetry</div>
      </figure>
    )
  }

  <h3 class="mt-5 font-serif text-[28px] leading-tight font-extrabold text-sepia-900" data-a>{p.title}</h3>
  <p class="mt-0.5 font-serif text-[13.5px] text-sepia-500 italic" data-a>{p.meta}</p>
  <p class="mt-2 text-[13.5px] leading-[1.55] text-sepia-700" data-a>{p.description}</p>
  <ul class="mt-2.5 space-y-1 text-[12.5px] leading-5 text-sepia-700" data-a>
    {p.points.map((pt) => <li class="flex gap-2"><span class="text-ember-600">—</span><span>{pt}</span></li>)}
  </ul>
  <div class="mt-3 flex flex-wrap gap-1.5" data-a>{p.tech.map((t) => <span class="chip">{t}</span>)}</div>
  <div class="mt-4 flex flex-wrap items-center gap-3" data-a>
    {p.demo && <a href={p.demo} target="_blank" rel="noreferrer" class="btn-ink" aria-label={`Open ${p.title} live site`}>Live site</a>}
    {
      p.github ? (
        <a href={p.github} target="_blank" rel="noreferrer" class="btn-ghost" aria-label={`View ${p.title} source code on GitHub`}>Source</a>
      ) : (
        <span class="inline-flex items-center gap-1.5 text-[12.5px] text-sepia-500"><Lock class="h-3.5 w-3.5" />Private repository</span>
      )
    }
  </div>
</Page>
