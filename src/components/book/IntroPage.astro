---
import Page from './Page.astro';
import Kicker from './Kicker.astro';
import { socials } from '@/data/site';
---

<Page anchor="hello" chapter="Hello" num={1}>
  <Kicker label="Chapter I" right="Hello" />
  <p class="mt-10 font-serif text-lg text-sepia-500 italic" data-a>Welcome. This portfolio is a book.</p>
  <h1 class="mt-2 font-serif text-[52px] leading-[1.02] font-extrabold text-sepia-900" id="intro-title">
    Hello, I'm<br /><span class="text-ember-600">Mubashir</span>
  </h1>
  <p class="mt-4 text-[15px] font-medium text-sepia-700" data-a>Full stack developer. Cloud, AI and security.</p>
  <p class="mt-3 text-[14px] leading-6 text-sepia-700" data-a>
    I build web applications with Next.js, React, TypeScript, Supabase and PostgreSQL, and ship them with Docker, AWS
    and CI/CD pipelines. I'm especially interested in AI automation and cloud infrastructure.
  </p>
  <div class="mt-5 flex flex-wrap gap-3" data-a>
    <a href="#projects" class="btn-ink">View Projects</a>
    <a href="#contact" class="btn-ghost">Contact Me</a>
  </div>
  <div class="mt-4 flex gap-5 text-[13px] font-medium text-sepia-500" data-a>
    {socials.map((s) => <a href={s.href} target="_blank" rel="noreferrer" aria-label={s.aria} class="ink-link">{s.label}</a>)}
  </div>
</Page>
