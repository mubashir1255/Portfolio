---
/**
 * Background ASCII globe. Fixed behind the page; in Play mode it turns as you scroll.
 * Drawn on a <canvas> (it's a picture, not text). Lahore's glowing light is a small element
 * over the canvas so its CSS pulse runs without redrawing. Without JavaScript, a text version
 * of the first frame (rendered at build time) shows instead.
 */
import { geometry, renderGlobe, START_LON } from '@/lib/globe';

const COLS = 120;
const html = renderGlobe(geometry(COLS), START_LON);
---

<div class="bg-globe" aria-hidden="true" data-cols={COLS}>
  <div class="bg-globe__stage">
    <canvas class="bg-globe__canvas"></canvas>
    <span class="bg-globe__light" hidden></span>
  </div>
  <noscript><pre class="bg-globe__art" style={`--cols: ${COLS}`} set:html={html} /></noscript>
</div>

<script>
  import { geometry, frame, K, START_LON } from '@/lib/globe';
  import { effectsWanted, onPlayChange } from '@/scripts/play';

  const root = document.querySelector<HTMLElement>('.bg-globe');
  const canvas = root?.querySelector<HTMLCanvasElement>('.bg-globe__canvas');
  const light = root?.querySelector<HTMLElement>('.bg-globe__light');
  const ctx = canvas?.getContext('2d');

  if (root && canvas && light && ctx) {
    const g = geometry(Number(root.dataset.cols));
    const DEG_PER_PX = 0.09; // about one full turn per 4000px of scrolling
    const COLOURS: Record<number, string> = {
      [K.Land]: 'rgba(20, 18, 15, 0.52)',
      [K.Rim]: 'rgba(20, 18, 15, 0.45)',
      [K.Grid]: 'rgba(0, 87, 255, 0.75)',
      [K.PakFill]: 'rgba(0, 87, 255, 0.9)',
      [K.PakBorder]: '#0057ff',
    };
    const FONT = 'ui-monospace, SFMono-Regular, Menlo, "DejaVu Sans Mono", Consolas, monospace';
    let size = 0; // CSS px, square (set by CSS)
    let cellW = 0;
    let cellH = 0;
    let stretch = 1; // squeezes the font's real advance onto the cell grid
    let lastLon = NaN;
    let queued = false;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      size = canvas.getBoundingClientRect().width; // set by CSS: min(78vh, 94vw)
      cellW = size / g.cols;
      cellH = size / g.rows;
      canvas.width = canvas.height = Math.round(size * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `700 ${cellH}px ${FONT}`;
      ctx.textBaseline = 'top';
      stretch = cellW / (ctx.measureText('M'.repeat(20)).width / 20);
      lastLon = NaN;
      draw();
    };

    /** One fillText per row per colour (a few hundred calls), not one call per character. */
    const draw = () => {
      queued = false;
      // scrolling down turns it the way the Earth turns: continents move left to right
      const lon = effectsWanted() ? START_LON - scrollY * DEG_PER_PX : START_LON;
      const step = Math.round(lon * 2) / 2; // redraw only when it moved half a degree
      if (step === lastLon || !size) return;
      lastLon = step;
      const f = frame(g, step);
      ctx.clearRect(0, 0, size, size);
      ctx.save();
      ctx.scale(stretch, 1);
      for (const [kindKey, colour] of Object.entries(COLOURS)) {
        const k = Number(kindKey);
        ctx.fillStyle = colour;
        for (let r = 0; r < f.rows; r++) {
          let line = '';
          let any = false;
          for (let c = 0; c < f.cols; c++) {
            const i = r * f.cols + c;
            if (f.kind[i] === k) {
              line += f.chars[i];
              any = true;
            } else line += ' ';
          }
          if (any) ctx.fillText(line, 0, r * cellH);
        }
      }
      ctx.restore();
      if (f.home >= 0) {
        light.hidden = false;
        light.style.left = `${((f.home % f.cols) + 0.5) * cellW}px`;
        light.style.top = `${(((f.home / f.cols) | 0) + 0.5) * cellH}px`;
        light.style.setProperty('--cell', `${Math.max(cellW, 4)}px`);
      } else light.hidden = true;
    };

    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(draw);
      }
    };
    // Start once the browser is idle, so drawing never competes with the page loading.
    const start = () => {
      resize();
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', () => requestAnimationFrame(resize));
      onPlayChange(queue);
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 200);
  }
</script>
