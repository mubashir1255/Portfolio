---
/** Layout for the Manga Volume design. JSON-LD and the rest of the SEO pass land in Phase 5. */
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter';
import '@/styles/manga.css';
import { withBase } from '@/lib';

interface Props {
  title: string;
  description: string;
  /** keep the page out of search engines (styleguide) */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('og.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta name="theme-color" content="#f6f4ee" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mubashir Fayyaz — Full Stack Developer · Cloud · AI · Security" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Restore Play mode before first paint so the page doesn't flash. -->
    <script is:inline>
      try {
        if (localStorage.getItem('play-mode') === 'on') document.documentElement.dataset.play = 'on';
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="btn btn--primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50">Skip to content</a>
    <slot />
  </body>
</html>
